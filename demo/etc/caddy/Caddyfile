{
	email admin@example.com
}

# Shared SSO gate, imported by the sites that want it.
(sso) {
	forward_auth localhost:9091 {
		uri /api/verify
		copy_headers Remote-User
	}
}

grafana.example.com {
	import sso
	reverse_proxy localhost:3000
}

# Added while testing the new dashboards. Still here.
grafana-dev.example.com {
	import sso
	reverse_proxy localhost:3100
}

cloud.example.com {
	reverse_proxy localhost:8081
}

qbit.example.com {
	reverse_proxy localhost:8112
}

sonarr.example.com {
	basicauth {
		admin $2a$14$notarealhashnotarealhashnotarealhashnotarealhashnotareal
	}
	reverse_proxy localhost:8989
}
